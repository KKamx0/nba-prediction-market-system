# Copy to .env and fill in locally. Never commit .env.
# Every value here is a placeholder.

# --- Polymarket US (only needed for LiveExecutor / private WebSocket) -------
# Created at polymarket.us/developer after KYC. Secret is shown once.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# --- Benchmark odds ----------------------------------------------------------
ODDS_API_KEY=

# --- LLM news extraction (optional; without a key the loop runs without news)
ANTHROPIC_API_KEY=
# comma-separated RSS feeds; defaults to ESPN NBA news
NEWS_FEEDS=

# --- Reporting ---------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# --- Runtime -----------------------------------------------------------------
# Paper mode is the default. Live trading also requires --confirm-live and
# passing every gate in the paper -> live checklist.
PAPER_BANKROLL=1000
LIVE_TRADING=false
JURISDICTION_CLEARED=false
# hard cap on dollars live trading may use, whatever the account holds
LIVE_BANKROLL_CAP=0
# leave false until a one-contract preview confirms the short-side price convention
LIVE_ALLOW_SHORT=false
EDGEBOT_DB_PATH=data/edgebot.db
EDGEBOT_LOG_LEVEL=INFO
