# Copy to .env and fill in locally. Never commit .env.
# Every value here is a placeholder.

# --- Polymarket US (only needed for LiveExecutor / private WebSocket) -------
# Created at polymarket.us/developer after KYC. Secret is shown once.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

# --- Benchmark odds ----------------------------------------------------------
ODDS_API_KEY=

# --- LLM news extraction -----------------------------------------------------
ANTHROPIC_API_KEY=

# --- Reporting ---------------------------------------------------------------
DISCORD_WEBHOOK_URL=

# --- Runtime -----------------------------------------------------------------
# Paper mode is the default. Live trading also requires --confirm-live and
# passing every gate in the paper -> live checklist.
LIVE_TRADING=false
JURISDICTION_CLEARED=false
EDGEBOT_DB_PATH=data/edgebot.db
EDGEBOT_LOG_LEVEL=INFO
